# 專案根目錄環境變數 — 供 docker-compose.yml 讀取（與 backend/.env、frontend/.env.local 是不同檔案）
#
# 使用方式：
#   cp .env.example .env
#   然後把下方 SECRET_KEY 換成真正的隨機值，指令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ⚠️ 必填：JWT簽章密鑰，正式環境沒有正確設定會直接拒絕啟動（見 app/config.py 的資安防呆機制）
SECRET_KEY=change-me-run-the-python-command-above-to-generate-a-real-secret

# 環境識別：production 時會關閉 /docs 與 /redoc，並強制檢查 SECRET_KEY 已更換
ENVIRONMENT=development

# 允許跨網域請求的前端網址，正式環境請改為實際網域，多個網域用逗號分隔
CORS_ORIGINS=http://localhost:3000

# 資料庫密碼（本機開發可用預設值，正式環境務必更換）
DB_PASSWORD=erp_pass_2025
