DATABASE_URL=postgresql+asyncpg://erp_user:erp_pass_2025@localhost:5432/acrylic_erp
REDIS_URL=redis://localhost:6379/0
# 正式環境部署前務必更換為隨機密鑰，執行以下指令產生：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=480
TENANT_ID=default

# 資安相關設定
# ENVIRONMENT=production 時會：①強制檢查SECRET_KEY已更換 ②關閉/docs與/redoc公開文件
ENVIRONMENT=development
# 允許跨網域請求的前端網址，多個網域用逗號分隔，正式環境請改為實際網域（不可用萬用字元*）
CORS_ORIGINS=http://localhost:3000
